<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- miuix-blur 的 minSdk 是 33（RuntimeShader 是 Android 13 才有的 API）。
         本项目仍要装到 Android 8 起的设备，所以强制合并；代码里用
         isRuntimeShaderSupported() 做门控，33 以下自动降级为半透明玻璃，不会走到 RuntimeShader。 -->
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 触感反馈：列表行、开关、按钮、导航切换 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 长任务（一年期搬运 / 批量写回）期间阻止 CPU 休眠，锁屏后仍能继续发请求 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 长任务改为前台服务：只持 WakeLock 挡不住 Doze 断网与后台清理 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14 起 dataSync 类型必须单独声明这个权限，否则 startForeground 直接抛 SecurityException -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 13 起通知要用户授权；没有也只是看不到进度，服务本身照跑 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 长任务期间持有 Wi-Fi 高性能锁：锁屏后 Wi-Fi 会切省电模式，RTT 涨 10 倍，搬运明显变慢 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- 「后台加速」入口：跳系统的「不限制电池」确认框 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".FitSyncApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FitSync">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 长任务保活：搬运 / 回填 / 导入写回期间把进程钉在前台，并显示进度与「停止」。
             stopWithTask=false：从最近任务划掉 App 时不让服务跟着一起结束 —— 国产 ROM
             仍可能直接杀进程，但至少系统层面不再主动收掉它。 -->
        <service
            android:name=".sync.LongTaskService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <!-- 成绩卡片分享：把 cache/share 里的 PNG 以 content:// 给出去 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>